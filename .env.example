# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new `.env` file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# `.env` and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Database (Prisma) — local native PostgreSQL (Debian/Ubuntu/WSL with postgresql-common).
# Install postgresql-common and a server package (e.g. postgresql-17). Use a dedicated port
# per project. Set LOCAL_PG_CLUSTER_NAME so ./setup.sh can create/start the cluster, DB,
# and role. Set DATABASE_URL and DIRECT_URL to the SAME connection string (no local pooler).
# Use sslmode=disable for typical local TCP without TLS. URL-encode reserved characters in
# the password for the connection URL (@ # : / ? etc.).
#
# LOCAL_PG_CLUSTER_NAME="juntbox"
# LOCAL_PG_VERSION="17"
# LOCAL_PG_PORT="5500"
# LOCAL_PG_DATABASE="juntbox"
# LOCAL_PG_USER="juntbox"
# LOCAL_PG_PASSWORD="change-me"
#
# DATABASE_URL="postgresql://juntbox:change-me@127.0.0.1:5500/juntbox?sslmode=disable"
# DIRECT_URL="postgresql://juntbox:change-me@127.0.0.1:5500/juntbox?sslmode=disable"

DATABASE_URL=""
DIRECT_URL=""

NODE_VERSION="22.15.0"
